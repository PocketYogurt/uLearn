SECRET_KEY=change-this-to-a-random-32-plus-character-string

# The URL your reverse proxy serves the frontend from, e.g. https://learn.example.com
# Multiple origins can be comma-separated. Defaults to http://localhost:4173 if unset.
CORS_ORIGINS=http://localhost:4173

# Credentials for the //192.168.1.203/lanstorage_01 SMB share, used to mount
# courses/ directly via Docker's CIFS volume driver. Each .env is per-project,
# so these need setting here too even if readmeabook already has its own copy.
LAN1_USER=
LAN1_PASS=
